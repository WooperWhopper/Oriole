{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "jest"],
    "outDir": ".tsbuild-scripts"
  },
  "include": [
    "scripts/**/*",
    "test/**/*",
    "src/types.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
